PORT=5000

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=querybridge

# Google AI Studio API key (keep this file private; never put the key in the client)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Optional MongoDB query history
MONGODB_URI=mongodb://127.0.0.1:27017/querybridge

MYSQL_CONNECT_TIMEOUT_MS=10000
MYSQL_QUERY_TIMEOUT_MS=10000
MYSQL_CONNECTION_LIMIT=10
